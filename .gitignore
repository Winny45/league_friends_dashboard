# ---------------------------------------------------------------------------
# Secrets and personal data — never commit these.
#
# config.json holds a live Riot API key and the real Riot IDs of everyone
# being tracked. Everything else below is generated from real accounts and
# contains puuids, Riot IDs, match ids and full match history.
#
# Use config.example.json / data.example.json as the public templates.
# ---------------------------------------------------------------------------
config.json

# Generated output built from real accounts
data.json
dashboard.html

# Local caches of real account data (regenerated by fetch_data.py)
matches_cache.json
scrape_log.json
rank_history.json
champions_cache.json

# Anything else a user drops in alongside their own config
config.*.json
!config.example.json
data.*.json
!data.example.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
